# docker/shabbos-goy.env — secrets and per-deployment overrides for the
# `shabbos-goy` Compose service. Copy this file to docker/shabbos-goy.env
# (gitignored — see .gitignore) and fill in real values there. NEVER commit
# the real file; every value below is a placeholder.
#
# See CLAUDE.md's "Speech stack: lobes integration (planned)" and
# "Tool calling and climate control (planned)" sections for what each of
# these connects to.

# --- lobes (realtime + senses), reached over the compose network -----------
# docker-compose.yml uses `network_mode: host` (see its top comment for why),
# so lobes is reached at localhost, not host.docker.internal — override the
# port only if your deployment puts lobes on a different port than 8001.
SHABBOS_GOY_LOBES_URL=ws://localhost:8001/v1/realtime
# Optional: only set this if the senses (Gemma) role listens on a different
# port/host than the realtime session above. Left unset, the decider falls
# back to SHABBOS_GOY_LOBES_URL.
# SHABBOS_GOY_SENSES_URL=http://localhost:8001

# The lobes gateway key. Never a real value here — this is the .example
# file. GATEWAY_API_KEY is lobes' own deployment variable name, accepted as
# a fallback if SHABBOS_GOY_LOBES_API_KEY is unset.
SHABBOS_GOY_LOBES_API_KEY=<lobes-gateway-key>
# GATEWAY_API_KEY=<lobes-gateway-key>

# Optional: which senses model to ask for (default is the decider's own
# built-in default — see shabbos_goy/decider/gemma.py).
# SHABBOS_GOY_SENSES_MODEL=<model-name>

# Optional: request timeout in seconds for the senses HTTP call.
# SHABBOS_GOY_SENSES_TIMEOUT=10

# --- Sensibo (AC actuation), read by the `sensibo` console script itself ---
# Cloud-only (home.sensibo.com) — this container needs internet access to
# reach it. Never a real key here.
SENSIBO_API_KEY=<sensibo-api-key>

# --- host uid/gid (must match the host user who owns the PipeWire socket) --
# Defaults to 1000:1000 if unset; only set these if your host user's uid/gid
# differ (check with `id -u` / `id -g`).
# SHABBOS_GOY_UID=1000
# SHABBOS_GOY_GID=1000
